<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain">
    <!--
    See propel documentation on http://propelorm.org for all information about schema file
    -->

    <!--
    A tab is attached to a Thelia item through the (item_type, item_id) pair rather than
    through a dedicated table per type. item_type holds a Tabs\Enum\TabItemType value.

    A polymorphic column cannot carry a foreign key, so the ON DELETE CASCADE the four
    former tables relied on is replaced by Tabs\EventListener\ItemDeleteListener.
    -->
    <table name="item_associated_tab" namespace="Tabs\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="item_type" required="true" size="32" type="VARCHAR" />
        <column name="item_id" required="true" type="INTEGER" />
        <column name="position" defaultValue="0" required="true" type="INTEGER" />
        <column name="visible" defaultValue="1" required="true" type="TINYINT" />
        <!-- Moved to item_associated_tab_i18n by the i18n behavior below. -->
        <column name="title" size="255" type="VARCHAR" />
        <column name="description" type="CLOB" />

        <index name="idx_item_associated_tab_item">
            <index-column name="item_type" />
            <index-column name="item_id" />
        </index>

        <behavior name="timestampable" />
        <!-- Positions are numbered independently for each (item_type, item_id) pair. -->
        <behavior name="sortable">
            <parameter name="rank_column" value="position" />
            <parameter name="use_scope" value="true" />
            <parameter name="scope_column" value="item_type,item_id" />
        </behavior>
        <behavior name="i18n">
            <parameter name="i18n_columns" value="title,description" />
        </behavior>
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true" />
</database>
