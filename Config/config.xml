<?xml version="1.0" encoding="UTF-8" ?>

<!--
    TheliaKernel loads this file for every activated module without checking that it exists,
    so it has to stay even though it declares nothing.

    Loops, forms and hooks are auto-discovered in Thelia 3: forms through the `thelia.form`
    tag (Thelia\Core\DependencyInjection\Compiler\RegisterFormPass), hooks through
    Tabs\Hook\Back\TabsBackHook::getSubscribedHooks(). Routes use #[Route] attributes.
-->
<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">
</config>
