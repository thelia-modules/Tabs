{% set d = 'tabs' %}
{% set can_update = is_granted('UPDATE', { resource: 'admin.module', module: 'Tabs' }) %}
{% set can_delete = is_granted('DELETE', { resource: 'admin.module', module: 'Tabs' }) %}

{% if can_update %}
	{% form_theme form with bo_form_themes only %}
	{{form_start(form, {
		action : path('tabs.admin.save'),
		attr : {
			method: 'POST',
			'data-testid' : 'tabs-'~item_type~'-create-submit'
		}
	}) }}
	{{ form_errors(form) }}
	{{form_rest(form) }}
	<button type="submit" class="btn btn-primary" data-testid="tabs-{{ item_type }}-create-submit">
		<i class="bi bi-check2" aria-hidden="true"></i>
		{{ 'Save'|trans }}
	</button>
	{{form_end(form) }}
{% endif %}

{% if tabs is not empty %}
	<div class="mt-4 accordion" id="tabs-{{ item_type }}-accordion">
		{% for tab in tabs %}
			{% set editForm = getForm('tabs_tab',{
				item_id,
				item_type,
				tab_id: tab.id,
				title: tab.title,
				description: tab.description,
				visible: tab.visible == 1,
				locale: edit_language_locale
			}) %}

			<div class="accordion-item">
				<div class="gap-2 accordion-header d-flex align-items-center pe-2">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tabs-collapse-{{ tab.id }}" aria-expanded="false" aria-controls="tabs-collapse-{{ tab.id }}">
						{{ tab.title }}
					</button>

					{% if can_update %}
						<div class="flex-shrink-0 btn-group btn-group-sm" role="group" aria-label="{{ 'Position'|trans }}">
							<a class="btn btn-outline-secondary{% if loop.first %} disabled{% endif %}" title="{{ 'Move up'|trans }}" href="{{ path('tabs.admin.move', { tabId: tab.id, mode: 'up' }) }}">
								<i class="bi bi-arrow-up" aria-hidden="true"></i>
							</a>
							<span class="btn btn-outline-secondary disabled">{{ tab.position }}</span>
							<a class="btn btn-outline-secondary{% if loop.last %} disabled{% endif %}" title="{{ 'Move down'|trans }}" href="{{ path('tabs.admin.move', { tabId: tab.id, mode: 'down' }) }}">
								<i class="bi bi-arrow-down" aria-hidden="true"></i>
							</a>
						</div>
					{% else %}
						<span class="flex-shrink-0 badge text-bg-secondary">{{ tab.position }}</span>
					{% endif %}

					{% if can_delete %}
						<a class="flex-shrink-0 btn btn-sm btn-danger" href="#tabs_delete_dialog" title="{{ 'Delete this tab'|trans({}, d) }}" data-id="{{ tab.id }}" data-bs-toggle="modal" data-bs-target="#tabs_delete_dialog">
							<i class="bi bi-trash" aria-hidden="true"></i>
						</a>
					{% endif %}
				</div>

				<div id="tabs-collapse-{{ tab.id }}" class="accordion-collapse collapse" data-bs-parent="#tabs-{{ item_type }}-accordion">
					<div class="accordion-body">
						{{form_start(editForm, {
							action : path('tabs.admin.save'),
						}) }}
							{{ form_row(editForm.title, {
								'id': 'tab_title_'~tab.id
							}) }}
							{{ form_row(editForm.description, {
								'id': 'tab_description_'~tab.id
							}) }}
							{{ form_row(editForm.visible, {
								'id': 'tab_visible_'~tab.id
							}) }}
							{{ form_rest(editForm) }}
							<button type="submit" class="btn btn-primary">
								<i class="bi bi-check2" aria-hidden="true"></i>
								{{ 'Save'|trans }}
							</button>
						{{form_end(editForm) }}
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
{% endif %}

{% if can_delete %}
	{% component 'BoConfirmDialog' with {
        id: 'tabs_delete_dialog',
        title: 'Delete tab'|trans({}, d),
        message: 'Do you really want to delete this tab ?'|trans({}, d),
        formAction: path('tabs.admin.delete'),
        prefillTrigger: 'data-id',
        prefillInput: 'tab_id',
        testid: 'tabs-delete',
    } %}{% endcomponent %}
{% endif %}
