{#
    Twig counterpart of the Smarty `tabs-config.html` configuration page.

    `admin-layout.tpl` becomes the Twig back-office base layout, and the `main-content`
    Smarty block becomes the `content` block.
#}
{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Tabs module configuration'|trans({}, 'tabs') }}{% endblock %}
{% block body_testid %}tabs-config{% endblock %}

{% block content %}
    <div class="container-fluid">
        <h1 class="h3 mb-3">{{ 'Tabs module configuration'|trans({}, 'tabs') }}</h1>

        <div class="card">
            <div class="card-body">
                <a class="btn btn-danger" href="{{ thelia_url('/admin/module/Tabs/init') }}">
                    {{ 'Init all tabs position'|trans({}, 'tabs') }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
